{
  "name": "pixacad",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "themes": "node scripts/build-themes.mjs",
    "desktop:dev": "wails dev",
    "desktop:build": "wails build -clean && go run github.com/tc-hib/go-winres@v0.3.3 patch --in winres/winres.json --delete --no-backup build/bin/pixaCAD.exe"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^4.4.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.4"
  }
}
